# ============================================================
# PredictIQ — Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in the values.
# The .env file stays on your computer only — never goes to GitHub.
# ============================================================

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_DB=predictiq_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ── FastAPI ──────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=2
LOG_LEVEL=info

# ── Airflow ──────────────────────────────────────────────────
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__FERNET_KEY=
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=false
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__WEBSERVER__EXPOSE_CONFIG=false
AIRFLOW__WEBSERVER__SECRET_KEY=
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://postgres:YOURPASSWORD@postgres:5432/airflow_db
AIRFLOW__LOGGING__LOGGING_LEVEL=INFO
AIRFLOW_UID=50000

# ── Streamlit ────────────────────────────────────────────────
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_SERVER_ENABLE_CORS=false
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

# ── Data paths (inside containers) ──────────────────────────
PREDICTIQ_DATA_DIR=/app/data
PREDICTIQ_PROCESSED_DIR=/app/data/processed
PREDICTIQ_BATCH_SIZE=100